# =====================================================================
# idaas-cli-obo sample 环境配置模板
#
# 使用方法：
#   1. cp env.template .env && chmod 600 .env
#   2. 填入必填项（<YOUR_...> 占位符），可选项留空即可
#   3. python3 sample.py --check 体检，缺哪项按提示补哪项
#
# 最小必填项（3 项）：REGION、ORDER_SERVICE_AUDIENCE、IDAAS_ORIGIN
# 其余端点/issuer 等将由 REGION+ENVIRONMENT 自动派生或 discovery 拉取。
#
# 管控面资源有两种准备方式（二选一）：
#   - 模式 A：python3 sample.py setup --mode=console 打印控制台点选清单，
#             人工在控制台创建资源后把产出抄录到本文件
#   - 模式 B：python3 sample.py setup --mode=script 用脚本自动创建并回写本文件
#             （需要凭据链配置与 SETUP_* 配置）
# =====================================================================

# ---- 环境与账号 ----
# 地域 ID，如 cn-hangzhou / ap-southeast-1（控制台右上角或产品文档可查）
REGION=<YOUR_REGION>
# 环境维度。合法取值**只有两个**：production / pre-release
#   （大小写与首尾空格会自动归一化，如 Pre-Release、" pre-release " 都认；
#     其余任何值（如 staging / pre_release）直接报错，不静默当 production）
# 决定 SIGNIN_BASE_URL 的自动派生形态，显式填 SIGNIN_BASE_URL 则覆盖。
# POOL_JWKS_BASE 只在**本行显式写了 production** 时才自动镜像为 SIGNIN_BASE_URL。
# 删除本行 / 留空 → 存量 .env 的向后兼容行为：按 production 派生登录域，
#   但 POOL_JWKS_BASE 保持留空（池 discovery/JWKS 走 DATA_ENDPOINT）。
ENVIRONMENT=production
# 阿里云 AccessKey（可选）
# 推荐走 aliyun CLI 凭据链（aliyun configure 一次即可），无需在此填私密信息；
# 显式填写则最高优先（向后兼容/CI）。凭据解析优先级：
#   1. 此处显式 AK/SK → 2. alibabacloud-credentials SDK 默认链 → 3. 标准库读 ~/.aliyun/config.json
# 取值：控制台「RAM 访问控制 → 用户 → AccessKey 管理」
# ⚠️ 两项必须同时填或同时留空；只填一项直接报错（CredentialError），不再静默降级到凭据链。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 可选：STS 临时凭证 SecurityToken（用临时凭证时填写；长期 AK 或凭据链留空）
ALIYUN_SECURITY_TOKEN=

# ---- 服务端点（留空自动从 REGION+ENVIRONMENT 派生）----
# 控制面端点（管理用户池/客户端/工作负载身份等资源）
# 自动派生形态：agentidentity.<REGION>.aliyuncs.com
CONTROL_ENDPOINT=
# 数据面端点（WAT / OBO 等运行时 RPC 接口）
# 自动派生形态：agentidentitydata.<REGION>.aliyuncs.com
DATA_ENDPOINT=
# 池 OAuth 登录根地址（authorize 与 token 兑换都走这个域名）
# 自动派生形态：production → https://signin-<REGION>.aliyunagentid.com
#               pre-release → https://signin.<REGION>.aliyuncs.com
# ⚠️ 双域名坑：token 兑换必须走 {SIGNIN_BASE_URL}/{USER_POOL_ID}/oauth2/token；
#    而 discovery / JWKS 的域名因环境而异（见下方 POOL_JWKS_BASE）——两者不一定是同个域名，别混用。
SIGNIN_BASE_URL=
# 可选：池 discovery / JWKS 的域名根（setup 创建 IdentityProvider 的 DiscoveryURL 用它）
# 留空时按 ENVIRONMENT 分两种情形：
#   ① 显式设置 ENVIRONMENT=production → 自动镜像为 SIGNIN_BASE_URL
#      （新加坡 ap-southeast-1 等正式环境：池 discovery/JWKS 走登录域，数据面同路径 404）
#   ② 未设置 ENVIRONMENT（存量 .env 形态，本行被删除/留空）或 ENVIRONMENT=pre-release
#      → 保持旧行为走 DATA_ENDPOINT（预发实测池 discovery 在数据面公网路径）
# 显式填写则最高优先，不受 ENVIRONMENT 影响。若所在环境的池 discovery/JWKS 走登录域
# （如新加坡 ap-southeast-1 正式环境：
#   {SIGNIN}/{poolId}/.well-known/openid-configuration 200，数据面同路径 404），
# 填登录域完整地址（可与 SIGNIN_BASE_URL 相同，含/不含 https:// 前缀均可）。
POOL_JWKS_BASE=

# ---- 管控面产出（模式 A 控制台抄录，或模式 B 脚本自动回写）----
# 用户池 ID（形态 up_ 后跟 32 位十六进制）
# 取值：控制台「云身份 Agent Identity → 用户池」列表，或 setup 产出
USER_POOL_ID=<YOUR_USER_POOL_ID>
# 池 OAuth 客户端 ID（数据面浏览器登录用，形态 client_ 后跟 32 位十六进制）
OAUTH_CLIENT_ID=<YOUR_OAUTH_CLIENT_ID>
# 池 OAuth 客户端密钥（token 兑换时需要；机密客户端才有）
OAUTH_CLIENT_SECRET=<YOUR_OAUTH_CLIENT_SECRET>
# 可选：密钥文件路径（0600 权限单行文件，优先于上一项，避免 secret 进 .env）
OAUTH_CLIENT_SECRET_FILE=
# 回调地址。默认 loopback 形态 http://127.0.0.1:8765/callback
# 说明：用户池客户端的 redirect_uri 白名单只要含任意一条 loopback 条目
#   （localhost 或 127.0.0.1）即放行且忽略端口；但 token 兑换时 redirect_uri
#   必须与 authorize 时逐字符一致——CLI 会按实际绑定端口动态构造两侧 URI。
#   若 8765 被占用（常见于本机 IDE 等常驻进程），用 login --port 换端口即可。
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback

# ---- 身份升维与出站（OBO）----
# 工作负载身份名（setup 创建，或控制台「工作负载身份」列表抄录）
WI_NAME=<YOUR_WORKLOAD_IDENTITY_NAME>
# 出站资源凭证提供商名（setup 创建，或控制台「凭证提供商」列表抄录）
OBO_PROVIDER_NAME=<YOUR_OAUTH2_CREDENTIAL_PROVIDER_NAME>

# ---- 订单服务（OBO 出站目标，模拟下游企业服务）----
# 订单服务受众：IDaaS 控制台该企业服务应用详情页的 audience 标识
# （如 test-aud 这类值）。⚠️ 不是 OBO provider 的 OutboundAudience
# （agent-… 形态）——传错将报 Forbidden.IdaasRsNotAuthorized（正式环境实测）。
ORDER_SERVICE_AUDIENCE=<YOUR_ORDER_SERVICE_AUDIENCE>
# 申请的 scope，逗号分隔。❗️ ORDER_SERVICE_SCOPES 必须与控制台授权 scope 逐字一致
# （德国实测控制台授权为 read:all 与 write:all）。
# 必须是目标应用已授权 scope 的子集——超出将报 Forbidden.ScopeNotGranted（正式环境实测；
# 排查时逐个删减做最小化实验）。
# 默认仅请求 write:all（演示 GET 返回本人订单 + POST 受理新订单的差异化效果）；
# 若需管理员视角（GET 全量订单）可改为 read:all,write:all。
ORDER_SERVICE_SCOPES=write:all
# 订单服务令牌（OBO AT）的签发方 issuer 与 JWKS 端点
# 留空自动从 IDAAS_ORIGIN 拉 discovery 填充（运行时 GET
#   {IDAAS_ORIGIN}/api/v2/iauths_system/oauth2/.well-known/openid-configuration
#   返回的 issuer / jwks_uri 字段）。显式填写则最高优先（向后兼容/离线场景）。
ORDER_SERVICE_ISSUER=
ORDER_SERVICE_JWKS_URI=
# IDaaS 实例域名根（如 https://xxx.cloud-idaas.com）
# 用于自动拉 discovery 文档填充上方 ISSUER/JWKS_URI；
# 若已显式填写 ORDER_SERVICE_ISSUER 可留空，将从 issuer 反向推导 origin。
IDAAS_ORIGIN=<YOUR_IDAAS_ORIGIN>

# ---- 仅 setup --mode=script 使用（模式 B 资源命名与绑定配置）----
# 用户池名（3~64 字符，账号内唯一；重跑按名复用，不重复创建）
SETUP_POOL_NAME=idaas-obo-sample-pool
# 池 OAuth 客户端名（池内唯一；回跳地址将注册为 OAUTH_REDIRECT_URI）
SETUP_CLIENT_NAME=idaas-obo-sample-cli
# 身份提供商名（CreateIdentityProvider 用，指向本池 discovery）
SETUP_IDP_NAME=idaas-obo-sample-idp
# 绑定 IDaaS 的身份源类型。
# ⚠️ aliyun CLI 帮助标注 SetSpecificIdentityProvider 当前仅支持 DingTalk，
#    IDaaS 类型以产品实际支持情况为准；若报 InvalidParameter，请改用控制台
#    完成「绑定 IDaaS」（模式 A 第 2 步）后重跑 setup（幂等，会跳过已完成步骤）。
SETUP_IDP_TYPE=IDaaS
# 绑定 IDaaS 所需的 IdP 元数据（JSON 字符串，字段以产品文档为准）
SETUP_IDP_METADATA=
# 出站凭证提供商厂商类型（如 IDaaS；以产品文档为准）
SETUP_OBO_VENDOR=IDaaS
# 出站提供商配置（JSON 字符串：clientId/clientSecret 等，指向 IDaaS 侧
# 订单服务应用；字段结构以 aliyun agentidentity create-oauth2-credential-provider
# --help 中 OAuth2ProviderConfig 的说明为准）
SETUP_OBO_PROVIDER_CONFIG=
