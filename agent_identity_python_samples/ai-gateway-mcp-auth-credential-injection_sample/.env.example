# ═══════════════════════════════════════════════════
#  MCP Chatbot 环境配置模板
#  复制本文件为 .env 并填入实际值：
#    cp .env.example .env
# ═══════════════════════════════════════════════════

# ─── OIDC 配置（必需）─────────────────────────────────
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ─── Agent Identity Workload Identity（必需）───────────
# 在 Agent Identity 控制台创建的 Workload Identity 名称，用于以 ID Token 换取 WAT
AGENT_IDENTITY_WORKLOAD_IDENTITY_NAME=

# ─── LLM 配置（必需）──────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=

# ─── MCP 配置（必需）──────────────────────────────────
MCP_SERVER_URL=

# ─── 可选配置 ─────────────────────────────────────────
# AGENT_IDENTITY_REGION_ID=cn-beijing
# LLM_MODEL=qwen-max
